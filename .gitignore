# Build output (made by make build / make install)
/bin/
*.test
*.out
coverage.*

# Where records and labels live. They are calibration material and differ per environment. eval-model.sh keeps them apart in .shikii-eval/<name>/
/.shikii/
/.shikii-*/

# Material for the comparison bench (scripts/bench/rag-rows.py builds it from the saved truths)
/testdata/prompt-intent-rag.json

# Keys and environment. Pass keys in the DECISIONS_API_KEY / TYPESAFE_API_KEY environment variables (never in files)
.env
.env.*
*.key

# Tool state (Serena, editors, OS)
/.serena/
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Temporary files from experiments (scratch goes under /private/tmp, but in case some land here)
*.log
*.tmp
/tmp/

# Python cache (scripts/bench/lora)
__pycache__/

# Dependencies of the page (web/). The build output web/dist is committed (so go install works with Go alone)
/web/node_modules/
web/.ui-test/

# Memory is not kept in the repo (the source of truth is ~/.claude/projects/shikii-shared/; see CLAUDE.md)
/.claude/memory/

# Local records of work, checks and updates. Not part of the published documents
/docs/operations.md

# This project's working rules (for agents, kept only on the owner's machine). Not shipped
/AGENTS.md
/CLAUDE.md
